# Copy this file to .env and adjust the values.
# .env is ignored by git and must never be committed.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=UTC

# Leave DATABASE_URL empty to use a local SQLite file (backend/db.sqlite3).
# Set it to share the remote PostgreSQL database between machines:
# DATABASE_URL=postgresql://user:password@host:5432/database_name
DATABASE_URL=

# In development everything is allowed. For deployment, set
# CORS_ALLOW_ALL_ORIGINS=False and list the frontend origins explicitly.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
